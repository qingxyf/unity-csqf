  m_Script: {fileID: 11500000, guid: d7e979fbed34413468065a17cf115b77, type: 3}
  m_Name: 月下商队
  eventName: 月下商队
  description: 一支没有车夫的商队在月光下缓慢前行，车厢里传来金币碰撞声。
  illustration: {fileID: 21300000, guid: 0be5ef839ef243d9831893c9bb4653e9, type: 3}
  choices:
  - buttonText: 交换补给
    resultDescription: 月光商队收下了补给，交给你一件实用的藏品。
    healthChange: -8
    grantCollectible: 1
  - buttonText: 守夜护卫
    resultDescription: 你整夜未眠，商队以护符作为酬谢。
    shieldGain: 20
    cardsToDraw: 1
  - buttonText: 悄然离开
    resultDescription: 你绕过商队，继续赶路。
