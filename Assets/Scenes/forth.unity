--- !u!114 &1739153037
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1739153033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n== \u72B6\u6001\u6548\u679C (Status Effects) ==\n[\u70E7\u4F24]\uFF1A\u5728\u63A5\u4E0B\u67652\u56DE\u5408\u5F00\u59CB\u65F6\u53D7\u523010\u70B9\u706B\u7130\u4F24\u5BB3\uFF0C\u653B\u51FB\u529B\u964D\u4F4E50%\r\n[\u8150\u8680]\uFF1A\u5728\u63A5\u4E0B\u67652\u56DE\u5408\u5F00\u59CB\u65F6\u53D7\u523010\u70B9\u6697\u5F71\u4F24\u5BB3\uFF0C\u53D7\u4F24\u65F6\u989D\u5916\u6263\u96645hp\r\n[\u51B0\u971C]\uFF1A\u5728\u63A5\u4E0B\u67652\u56DE\u5408\u5F00\u59CB\u65F6\u53D7\u52305\u70B9\u51B0\u971C\u4F24\u5BB3\r\n[\u51B0\u51BB]\uFF1A\u5728\u63A5\u4E0B\u67652\u56DE\u5408\u5F00\u59CB\u65F6\u53D7\u52305\u70B9\u51B0\u971C\u4F24\u5BB3\uFF0C\u672C\u56DE\u5408\u65E0\u6CD5\u884C\u52A8\r\n[\u4E2D\u6BD2]\uFF1A\u6BCF\u56DE\u5408\u5F00\u59CB\u65F6\u635F\u5931\u5F53\u524D\u751F\u547D\u503C\u768410%\uFF08\u81F3\u591A30\u70B9\uFF09\r\n[\u7729\u6655]\uFF1A\u672C\u56DE\u5408\u65E0\u6CD5\u884C\u52A8\r\n[\u6D41\u8840]\uFF1A\u5728\u63A5\u4E0B\u67652\u56DE\u5408\u5F00\u59CB\u65F6\u53D7\u523010\u70B9\u6697\u5F71\u4F24\u5BB3\uFF0C\u5E76\u4E14\u65E0\u6CD5\u56DE\u590D\u751F\u547D\u503C\r\n[\u6DF7\u4E71]\uFF1A\u4E0B\u6B21\u653B\u51FB\u65F6\uFF0C\u4F1A\u653B\u51FB\u81EA\u5DF1\r\n[\u865A\u5F31]\uFF1A\u4E0B\u6B21\u653B\u51FB\u65F6\uFF0C\u653B\u51FB\u529B-10\r\n[\u6C89\u9ED8]\uFF1A\u672C\u56DE\u5408\u8D77\uFF0C\u65E0\u6CD5\u4F7F\u7528\u5361\u724C\uFF0C\u6301\u7EED\u4E24\u4E2A\u56DE\u5408\r\n[\u51C0\u5316]\uFF1A\u672C\u56DE\u5408\u8D77\u65E0\u6CD5\u89E6\u53D1\u989D\u5916\u6548\u679C\uFF0C\u6301\u7EED\u4E09\u4E2A\u56DE\u5408\r\n[\u590D\u82CF]\uFF1A\u6BCF\u4E2A\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u56DE\u590D\u751F\u547D\u503C\u4E0A\u965020%\u7684hp\r\n[\u5BC4\u751F]\uFF1A\u6BCF\u4E2A\u56DE\u5408\u7ED3\u675F\u65F6\uFF0C\u5931\u53BB10%\u6700\u5927hp\uFF0C\u4EE4\u6765\u6E90\u56DE\u590D\u9020\u6210\u4F24\u5BB3\u768450%hp\r\n[\u65E0\u5C5E\u6027\u724C\u8BF4\u660E]\u9664\u975E\u724C\u9762\u6709\u8BF4\u660E\uFF0C\u4E0D\u7136\u4F7F\u7528\u5B8C\u6210\u540E\u4E0D\u8FDB\u5165\u5F03\u724C\u5806\u800C\u662F\u79FB\u51FA\u6E38\u620F\u76F4\u5230\u672C\u5C40\u6218\u6597\u7ED3\u675F\n==
    \u5143\u7D20\u53CD\u5E94 (Elemental Reactions) ==\n[\u71C3\u70E7\u4F24\u5BB3]\uFF1A\u5F53\u4F60\u9020\u6210[\u706B\u7130\u4F24\u5BB3]\u65F6\uFF0C\u82E5\u654C\u65B9\u62E5\u6709[\u5BC4\u751F]\u6216\u4E0A\u6B21\u53D7\u5230\u7684\u662F[\u751F\u673A\u4F24\u5BB3]\uFF0C\u5219\u4F24\u5BB3\u91CF\u589E\u52A0Base
    attack\u3002\r\n[\u84B8\u53D1\u6548\u679C]\uFF1A\u5F53\u4F60\u9020\u6210[\u51B0\u971C\u4F24\u5BB3]\u65F6,
    \u82E5\u654C\u65B9\u4E0A\u6B21\u53D7\u5230\u7684\u662F[\u706B\u7130\u4F24\u5BB3]\uFF0C\u968F\u673A\u6E05\u9664\u5BF9\u9762\u4E00\u4E2A\u589E\u76CA\u6548\u679C\u3002\r\n[\u4E30\u9976\u751F\u957F]\uFF1A\u5F53\u4F60\u9020\u6210[\u751F\u673A\u4F24\u5BB3]\u65F6\uFF0C\u82E5\u654C\u65B9\u4E0A\u6B21\u53D7\u5230\u7684\u662F[\u51B0\u971C\u4F24\u5BB3]\uFF0C\u5EF6\u957F\u5BF9\u9762\u968F\u673A\u4E00\u4E2A\u8D1F\u9762\u6548\u679C\u4E00\u4E2A\u56DE\u5408\u3002\r\n[\u5149\u6697\u53CC\u751F]\uFF1A\u5F53\u4F60\u9020\u6210[\u6697\u5F71\u4F24\u5BB3]/[\u5723\u5149\u4F24\u5BB3]\u65F6\uFF0C\u82E5\u654C\u65B9\u4E0A\u6B21\u53D7\u5230\u7684\u662F[\u5723\u5149\u4F24\u5BB3]/[\u6697\u5F71\u4F24\u5BB3]\uFF0C\u4F7F\u81EA\u8EAB\u4E0B\u4E00\u6B21\u53D7\u5230\u4F24\u5BB3-10\uFF08\u4E0D\u53EF\u53E0\u52A0\uFF09"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 82dd7b6e2c59ef14591d065ae6dfcc6b, type: 2}
